        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Regular photos use camera frames for a lighter scan. High-resolution photos add processing and are limited to one request every 3 seconds while the phone is cool. The shutter always saves a regular photo."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Las fotos normales usan cuadros de la cámara para un escaneo más ligero. Las fotos de alta resolución agregan procesamiento y se limitan a una solicitud cada 3 segundos mientras el teléfono no está caliente. El obturador siempre guarda una foto normal."
          }
        }
      }
    },
