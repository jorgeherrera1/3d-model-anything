        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Revisa las paredes, el nivel del piso y de qué lado de la puerta está cada cuarto. Esta es una colocación manual, no una coincidencia automática."
          }
        }
      }
    },
    "Choose a room already placed in the house as the reference.": {
      "localizations": {
